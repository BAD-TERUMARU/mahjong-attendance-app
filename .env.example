DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional. If omitted, the bot uses data/match-days.csv, then data/match-days.sample.csv.
MATCH_DAYS_CSV=

# Optional. If omitted, the bot uses data/members.csv, then data/members.sample.csv.
MEMBERS_CSV=

# Optional. Local CSV for opponent points.
POINTS_CSV=

# Optional. Published Google Sheets CSV URL for opponent points.
POINTS_CSV_URL=

# Optional. Defaults to data/store.json.
ATTENDANCE_STORE=

# Optional. Use "firestore" on Cloud Run.
STORAGE_DRIVER=local
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIRESTORE_COLLECTION=attendanceStores
STORE_ID=default
